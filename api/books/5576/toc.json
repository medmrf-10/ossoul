{"id": 5576, "slug": "ميزان-الأصول-في-نتائج-العقول", "title": "ميزان الأصول في نتائج العقول", "author": "علاء الدين السمرقندي", "death": "540", "toc": [{"i": 0, "t": "تقديم", "d": 0, "pg": 3}, {"i": 1, "t": "مقدمة وزارة الأوقاف القطرية", "d": 1, "pg": 3}, {"i": 2, "t": "كلمة افتتاحية", "d": 1, "pg": 5}, {"i": 3, "t": "تقديم للأستاذ الجليل الشيخ/ علي الخفيف", "d": 1, "pg": 9}, {"i": 4, "t": "أولا: المؤلف", "d": 1, "pg": 15}, {"i": 5, "t": "مقدمة المحقق", "d": 0, "pg": 15}, {"i": 6, "t": "ثانيا: الكتاب", "d": 1, "pg": 24}, {"i": 7, "t": "ثالثا: نسخ الكتاب ومنهجنا في النشر", "d": 1, "pg": 24}, {"i": 8, "t": "(أ) نسخ الكتاب", "d": 0, "pg": 24}, {"i": 9, "t": "(ب) منهجنا في النشر", "d": 0, "pg": 27}, {"i": 10, "t": "مقدمة المؤلف", "d": 0, "pg": 33}, {"i": 11, "t": "تعريف العلم وأنواعه", "d": 1, "pg": 40}, {"i": 12, "t": "منهج الكتاب", "d": 1, "pg": 43}, {"i": 13, "t": "الفصل الأول في بيان الأحكام", "d": 0, "pg": 44}, {"i": 14, "t": "الفصل الأول تفسير الحكم", "d": 1, "pg": 45}, {"i": 15, "t": "الفصل الثاني في بيان أنواع الأحكام", "d": 1, "pg": 54}, {"i": 16, "t": "[١] فمن جملتها كون الفعل: فرضا، وواجبا، و (*) مندوبا وسنة، ونفلا، وتطوعا", "d": 0, "pg": 55}, {"i": 17, "t": "[٢] ومن أنواع الأحكام أيضا كون الفعل: عبادة، وقربة، وطاعة", "d": 0, "pg": 65}, {"i": 18, "t": "[٣] ومن أنواع الأحكام، مما يدخل في العبادات والمعاملات، كون الفعل: صحيحا، وجائزا، ونافذا، وموقوفا. وكونه فاسدا، وباطلا", "d": 0, "pg": 67}, {"i": 19, "t": "[٤] ومن أنواع الأحكام أيضا كون الفعل: حراما، ومحرما، ومحظورا، ومنهيا، ومكروها وعلى مقابلتها كونه: حلالا، ومحللا، ومباحا، ومأذونا، ومطلقا، ومشروعا", "d": 0, "pg": 70}, {"i": 20, "t": "[٥] ومن أنواع الأحكام أيضا كون الفعل: حسنا، ومرضيا، وحقا، وصوابا، وعدلا، وحكمة", "d": 0, "pg": 75}, {"i": 21, "t": "[٦] ومن أنواع الأحكام كون الفعل: عزيمة، ورخصة", "d": 0, "pg": 84}, {"i": 22, "t": "[٧] ومن أنواع الأحكام كون الفعل: أداء، وقضاء، وإعادة", "d": 0, "pg": 92}, {"i": 23, "t": "[٨] ومن أنواع الأحكام كثرة من", "d": 0, "pg": 96}, {"i": 24, "t": "الفصل الثاني في بيان ما يعرف به الأحكام", "d": 0, "pg": 97}, {"i": 25, "t": "الدليل", "d": 0, "pg": 98}, {"i": 26, "t": "الفصل الأول أسماء ما يعرف به الأحكام وتفسيرها", "d": 1, "pg": 98}, {"i": 27, "t": "الحجة", "d": 0, "pg": 100}, {"i": 28, "t": "البرهان", "d": 0, "pg": 102}, {"i": 29, "t": "البينة", "d": 0, "pg": 102}, {"i": 30, "t": "الآية", "d": 0, "pg": 102}, {"i": 31, "t": "العلامة", "d": 0, "pg": 104}, {"i": 32, "t": "الفصل الثاني أنواع ما يعرف به الأحكام", "d": 1, "pg": 105}, {"i": 33, "t": "١ - الكلام في بيان الكتاب", "d": 0, "pg": 106}, {"i": 34, "t": "فصل في الأمر", "d": 0, "pg": 109}, {"i": 35, "t": "[١] أما التي ترجع إلى نفس الأمر", "d": 0, "pg": 110}, {"i": 36, "t": "[٢] وأما القسم الذي يرجع إلى الآمر", "d": 0, "pg": 191}, {"i": 37, "t": "[٣] وأما القسم الذي يرجع إلى المأمور به، وهو الفعل", "d": 0, "pg": 196}, {"i": 38, "t": "[٤] وأما القسم الذي يرجع إلى المأمور", "d": 0, "pg": 213}, {"i": 39, "t": "[٥] فصل في بيان القسم الذي يرجع إلى المأمور فيه وهو الزمان", "d": 0, "pg": 239}, {"i": 40, "t": "فصل في النهي", "d": 0, "pg": 252}, {"i": 41, "t": "[١] أما الأول", "d": 0, "pg": 252}, {"i": 42, "t": "[٢] فصل في بيان أقسام النهي", "d": 0, "pg": 255}, {"i": 43, "t": "[٣] مسألة - وأما حكم النهي، فنقول", "d": 0, "pg": 264}, {"i": 44, "t": "فصل في الخبر", "d": 0, "pg": 278}, {"i": 45, "t": "فصل في العام", "d": 0, "pg": 283}, {"i": 46, "t": "فصل في الخاص", "d": 0, "pg": 326}, {"i": 47, "t": "[١] أما الأول", "d": 0, "pg": 326}, {"i": 48, "t": "[٢] وأما بيان حكم الخاص", "d": 0, "pg": 329}, {"i": 49, "t": "[٣] وأما بيان ما يجوز تخصيصه, وما لا يجوز", "d": 0, "pg": 330}, {"i": 50, "t": "[٤] فصل - وأما ما يجوز به التخصيص وما لا يجوز [به]", "d": 0, "pg": 337}, {"i": 51, "t": "فصل في بيان المشترك والمؤول", "d": 0, "pg": 366}, {"i": 52, "t": "وأما حده عند أهل الأصول", "d": 0, "pg": 369}, {"i": 53, "t": "وأما تفسير المشترك في اللغة", "d": 0, "pg": 369}, {"i": 54, "t": "وأما المؤول", "d": 0, "pg": 377}, {"i": 55, "t": "فصل في بيان الظاهر، والنص، والمفسر، والمبين، والبيان، والمحكم وما يقابلها من الألفاظ الخفي، والمشكل، والمجمل، والمتشابه", "d": 0, "pg": 378}, {"i": 56, "t": "[١] [أما تفسير هذه الألفاظ لغة، وحدها عند أهل الأصول]", "d": 0, "pg": 378}, {"i": 57, "t": "[٢] وأما الأحكام التي تتصل بهذه الألفاظ", "d": 0, "pg": 389}, {"i": 58, "t": "فصل في بيان الحقيقة والمجاز", "d": 0, "pg": 396}, {"i": 59, "t": "[١] أما الأول", "d": 0, "pg": 396}, {"i": 60, "t": "[٢] وأما بيان الفاصل بين الحقيقة والمجاز، فنقول", "d": 0, "pg": 397}, {"i": 61, "t": "[٣] وأما كيفية طريق المجاز -[فنقول]", "d": 0, "pg": 401}, {"i": 62, "t": "[٤] وأما بيان أقسام الحقيقة والمجاز", "d": 0, "pg": 406}, {"i": 63, "t": "[٥] وأما بيان أحكام الحقيقة والمجاز", "d": 0, "pg": 411}, {"i": 64, "t": "فصل في بيان الصريح والكناية", "d": 0, "pg": 422}, {"i": 65, "t": "فصل في المطلق والمقيد", "d": 0, "pg": 425}, {"i": 66, "t": "فصل فيما يرجع إلى العبارة من حيث الإشارة، والدلالة، والإضمار، والاقتضاء", "d": 0, "pg": 426}, {"i": 67, "t": "فصل في الوجوه التي اختلف فيها: أنها ملحقة بالأحكام الثابتة باللفظ والعبارة أم لا؟", "d": 0, "pg": 434}, {"i": 68, "t": "[١] أما من حيث القول", "d": 0, "pg": 448}, {"i": 69, "t": "٢ - القول في السنة", "d": 0, "pg": 448}, {"i": 70, "t": "[٢] فصل في بيان السنة من حيث الفعل", "d": 0, "pg": 485}, {"i": 71, "t": "[٣] وأما السنة من حيث الترك والسكوت", "d": 0, "pg": 489}, {"i": 72, "t": "[٤] مسألة - اختلف العلماء في شرائع من قبلنا: هل تلزمنا؟", "d": 0, "pg": 497}, {"i": 73, "t": "[٥] مسألة نختم بها باب السنة وهي أن تقليد الصحابي، على التابعي المجتهد: هل هو واجب أو جائز - أم لا؟", "d": 0, "pg": 509}, {"i": 74, "t": "٣ - الكلام في الإجماع", "d": 0, "pg": 518}, {"i": 75, "t": "[١] أما بيان الإجماع لغة", "d": 0, "pg": 519}, {"i": 76, "t": "[٣] فصل في: بيان أهلية من ينعقد به الإجماع", "d": 0, "pg": 519}, {"i": 77, "t": "[٢] وأما حده وحقيقته عند أهل الأصول، وفي عرف الفقهاء", "d": 0, "pg": 519}, {"i": 78, "t": "[٤] فصل في: بيان شرائط الإجماع", "d": 0, "pg": 522}, {"i": 79, "t": "[٥] فصل في: بيان طريق وجود الإجماع", "d": 0, "pg": 544}, {"i": 80, "t": "[٦] فصل في: بيان السبب الداعي إلى الإجماع الحامل عليه", "d": 0, "pg": 552}, {"i": 81, "t": "[٧] فصل في: السبب المعرف للإجماع", "d": 0, "pg": 560}, {"i": 82, "t": "[٨] فصل في: بيان محل الإجماع", "d": 0, "pg": 561}, {"i": 83, "t": "[٩] فصل في: بيان حكم الإجماع", "d": 0, "pg": 563}, {"i": 84, "t": "[١٠] فصل - وأما بيان أن الإجماع الذي هو حجة قطعية نوع واحد أو أنواع", "d": 0, "pg": 579}, {"i": 85, "t": "٤ - القول في القياس", "d": 0, "pg": 580}, {"i": 86, "t": "[١] أما بيان تفسير القياس لغة", "d": 0, "pg": 581}, {"i": 87, "t": "[٢] وأما بيان حد القياس وحقيقته عند الفقهاء والمتكلمين", "d": 0, "pg": 582}, {"i": 88, "t": "[٣] فصل في: بيان مشروعية القياس", "d": 0, "pg": 584}, {"i": 89, "t": "[٤] فصل - وأما بيان أنواع القياس", "d": 0, "pg": 601}, {"i": 90, "t": "[٥] فصل في: بيان ركن القياس", "d": 0, "pg": 602}, {"i": 91, "t": "[٦] فصل في: بيان شرائط القياس والعلة", "d": 0, "pg": 644}, {"i": 92, "t": "[٧] فصل في: بيان حكم القياس", "d": 0, "pg": 677}, {"i": 93, "t": "[٨] فصل في بيان القياس والاستدلال الفاسدين (*)", "d": 0, "pg": 685}, {"i": 94, "t": "فصل في المعارضة", "d": 1, "pg": 715}, {"i": 95, "t": "[١] أما الأول", "d": 0, "pg": 715}, {"i": 96, "t": "الفصل الثالث التعارض", "d": 0, "pg": 715}, {"i": 97, "t": "[٢] وأما بيان حقيقته في عرف الفقهاء", "d": 0, "pg": 716}, {"i": 98, "t": "[٣] وأما بيان المخلص عن التعارض ودفعه", "d": 0, "pg": 716}, {"i": 99, "t": "[٤] وأما بيان حكم المعارضة شرعا", "d": 0, "pg": 724}, {"i": 100, "t": "فصل في النسخ", "d": 1, "pg": 725}, {"i": 101, "t": "[١] أما تفسيره", "d": 0, "pg": 726}, {"i": 102, "t": "[٢] وأما بيان أنه اسم شرعي أو اسم عرفي", "d": 0, "pg": 726}, {"i": 103, "t": "[٣] وأما بيان حده عند الفقهاء والمتكلمين", "d": 0, "pg": 727}, {"i": 104, "t": "[٤] فصل في: بيان مشروعية النسخ", "d": 0, "pg": 731}, {"i": 105, "t": "[٥] فصل في: بيان محل النسخ", "d": 0, "pg": 736}, {"i": 106, "t": "[٦] فصل في: بيان شروط النسخ", "d": 0, "pg": 740}, {"i": 107, "t": "[٧ و ٨] فصل في بيان: الناسخ والمسوخ، وبيان أقسامهما", "d": 0, "pg": 746}, {"i": 108, "t": "[٩] فصل في: بيان أقسام المنسوخ", "d": 0, "pg": 748}, {"i": 109, "t": "فصل في الترجيح", "d": 1, "pg": 758}, {"i": 110, "t": "[١] أما الترجيح في اللغة", "d": 0, "pg": 758}, {"i": 111, "t": "[٢] وأما في عرف الشرع", "d": 0, "pg": 759}, {"i": 112, "t": "[٣ و ٤] وأما محل الترجيح، ويندرج تحته بيان ما يقع به الترجيح", "d": 0, "pg": 759}, {"i": 113, "t": "[٥] وأما حكم تعارض الترجيحين", "d": 0, "pg": 770}, {"i": 114, "t": "الفصل الرابع أهلية الأحكام", "d": 0, "pg": 771}, {"i": 115, "t": "[١] بيانها", "d": 1, "pg": 771}, {"i": 116, "t": "[٢] وأما بيان كيفية تعلق الأحكام بالأسباب", "d": 1, "pg": 774}, {"i": 117, "t": "[٣] وأما بيان أعيان الأسباب", "d": 1, "pg": 778}, {"i": 118, "t": "فصل في بيان توابع القياس وهو بيان أحوال المجتهدين", "d": 0, "pg": 780}, {"i": 119, "t": "[١] وأما القسم الأول ما يرجع إلى المجتهد مع نفسه", "d": 1, "pg": 780}, {"i": 120, "t": "الأول", "d": 0, "pg": 781}, {"i": 121, "t": "الثاني", "d": 0, "pg": 782}, {"i": 122, "t": "[٢] وأما القسم [الثاني] الذي يرجع إلى حالة المجتهد مع غيره", "d": 1, "pg": 792}, {"i": 123, "t": "الاعتراضات الصحيحة", "d": 0, "pg": 796}, {"i": 124, "t": "الممانعة", "d": 0, "pg": 797}, {"i": 125, "t": "النقض", "d": 0, "pg": 799}, {"i": 126, "t": "فساد الوضع", "d": 0, "pg": 799}, {"i": 127, "t": "موجب العلة", "d": 0, "pg": 800}, {"i": 128, "t": "المعارضة", "d": 0, "pg": 800}, {"i": 129, "t": "الاعتراضات الفاسدة", "d": 0, "pg": 802}, {"i": 130, "t": "إرادة الحكم مع عدم العلة", "d": 0, "pg": 802}, {"i": 131, "t": "الفرق بين الأصل والفرع بمعنى آخر", "d": 0, "pg": 802}, {"i": 132, "t": "المراجع", "d": 0, "pg": 803}, {"i": 133, "t": "القرآن الكريم وتفسيره", "d": 1, "pg": 803}, {"i": 134, "t": "في الحديث", "d": 1, "pg": 803}, {"i": 135, "t": "في أصول الفقه", "d": 1, "pg": 804}, {"i": 136, "t": "الحنفية", "d": 0, "pg": 804}, {"i": 137, "t": "المالكية", "d": 0, "pg": 805}, {"i": 138, "t": "الشافعية", "d": 0, "pg": 805}, {"i": 139, "t": "الحنابلة", "d": 0, "pg": 805}, {"i": 140, "t": "في الفقه", "d": 1, "pg": 806}, {"i": 141, "t": "الحنفي", "d": 0, "pg": 806}, {"i": 142, "t": "الما